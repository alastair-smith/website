{
  "name": "@alastair-smith/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src",
    "test": "pnpm run test:unit --watch",
    "test:ci": "pnpm run test:unit",
    "test:unit": "vitest run",
    "predeploy": "envsubst < wrangler.template.toml > wrangler.toml",
    "deploy": "wrangler pages deploy dist",
    "start": "wrangler pages dev dist"
  },
  "dependencies": {
    "@fontsource/mulish": "^5.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.24.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@alastair-smith/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^4.20240909.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "20.2.3",
    "@types/react": "18.2.8",
    "@types/react-dom": "18.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "10.4.14",
    "jsdom": "^25.0.0",
    "msw": "^2.4.1",
    "postcss": "8.4.38",
    "tailwindcss": "3.3.2",
    "typescript": "5.1.3",
    "vite": "^5.3.0",
    "vitest": "^2.0.5",
    "wrangler": "^3.72.3"
  }
