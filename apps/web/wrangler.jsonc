{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website-frontend",
  "main": "./worker/api.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // unmatched paths serve /index.html, so react-router handles them
    "not_found_handling": "single-page-application",
    // without this the SPA fallback would swallow /api/* before the Worker runs
    "run_worker_first": ["/api/*"]
  }
  // uncomment to serve the live domain from this Worker
  // "routes": [{ "pattern": "alsmith.dev", "custom_domain": true }]
}
